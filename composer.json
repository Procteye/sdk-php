{
    "name": "procteye/procteye",
    "description": "Official server-side PHP SDK for the Procteye Integrity API.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "procteye",
        "integrity",
        "proctoring",
        "anti-cheat",
        "sdk",
        "webhooks"
    ],
    "homepage": "https://github.com/procteye/sdk-php",
    "support": {
        "docs": "https://docs.procteye.com",
        "source": "https://github.com/procteye/sdk-php"
    },
    "authors": [
        {
            "name": "Procteye"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Procteye\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Procteye\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "scripts": {
        "test": "phpunit"
    }
}
